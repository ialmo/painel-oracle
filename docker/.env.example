# Copie para docker/.env e ajuste para o SEU Oracle.
# (docker/.env não vai para o Git)
#
# Descobrir os valores do seu container:
#   docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Ports}}"
#   docker inspect <container> --format '{{range .Config.Env}}{{println .}}{{end}}'

# Nome do container onde o Oracle roda (os scripts SQL são executados nele)
DB_CONTAINER=oracle-23ai-free

# Senha do SYS/SYSTEM desse Oracle
#  - imagem gvenzl/oracle-free  -> variável ORACLE_PASSWORD
#  - imagem oficial da Oracle   -> variável ORACLE_PWD
ORACLE_PWD=OraclePass123

# Porta do Oracle publicada no seu computador (lado esquerdo de "1521->1521")
DB_PORT=1521
DB_SERVICE=FREEPDB1

# Porta do painel/ORDS no navegador
ORDS_HOST_PORT=8181
